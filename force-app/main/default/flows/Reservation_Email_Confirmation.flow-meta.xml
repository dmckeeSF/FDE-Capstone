    <description>Sends a confirmation email to the diner when a reservation is created, modified, or cancelled.</description>
    <formulas>
        <name>bodyFormula</name>
        <dataType>String</dataType>
        <expression>&quot;Hi &quot; &amp; {!dinerFirstName} &amp; &quot;,&quot; &amp; BR() &amp; BR() &amp;
IF(
  ISPICKVAL({!$Record.Status__c}, &quot;Cancelled&quot;),
  &quot;Your reservation has been cancelled.&quot;,
  IF(
    ISPICKVAL({!$Record.Status__c}, &quot;Modified&quot;),
    &quot;Your reservation has been updated. Here are your new details:&quot;,
    &quot;Great news — your reservation is confirmed! Here are your details:&quot;
  )
) &amp; BR() &amp; BR() &amp;
&quot;Booking Reference: &quot; &amp; {!$Record.Booking_Reference__c} &amp; BR() &amp;
&quot;Restaurant: &quot; &amp; {!$Record.Restaurant__r.Name} &amp; BR() &amp;
&quot;Date: &quot; &amp; TEXT({!$Record.Reservation_Date__c}) &amp; BR() &amp;
&quot;Time: &quot; &amp; {!$Record.Reservation_Time__c} &amp; BR() &amp;
&quot;Party Size: &quot; &amp; TEXT({!$Record.Party_Size__c}) &amp;
IF(
  NOT(ISBLANK({!$Record.Special_Requests__c})),
  BR() &amp; &quot;Special Requests: &quot; &amp; {!$Record.Special_Requests__c},
  &quot;&quot;
) &amp; BR() &amp; BR() &amp;
IF(
  ISPICKVAL({!$Record.Status__c}, &quot;Cancelled&quot;),
  &quot;We hope to welcome you back soon.&quot;,
  &quot;We look forward to seeing you. If you need to make changes, you can manage your reservation through the TableTopia portal.&quot;
) &amp; BR() &amp; BR() &amp;
&quot;The TableTopia Team&quot;</expression>
    </formulas>
    <formulas>
        <name>subjectFormula</name>
        <dataType>String</dataType>
        <expression>IF(
  ISPICKVAL({!$Record.Status__c}, &quot;Cancelled&quot;),
  &quot;Your reservation has been cancelled — &quot; &amp; {!$Record.Booking_Reference__c},
  IF(
    ISPICKVAL({!$Record.Status__c}, &quot;Modified&quot;),
    &quot;Your reservation has been updated — &quot; &amp; {!$Record.Booking_Reference__c},
    &quot;Booking confirmed — &quot; &amp; {!$Record.Booking_Reference__c}
  )
)</expression>
    </formulas>
    <label>Reservation Email Confirmation</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
