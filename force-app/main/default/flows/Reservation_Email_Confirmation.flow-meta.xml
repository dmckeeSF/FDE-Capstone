            <field>Email</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>dinerFirstName</assignToReference>
            <field>FirstName</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Diner_Contact</targetReference>
        </connector>
        <filterFormula>AND(
  NOT(ISBLANK({!$Record.Diner__c})),
  OR(
    ISNEW(),
    AND(ISCHANGED({!$Record.Status__c}), OR(ISPICKVAL({!$Record.Status__c}, &quot;Cancelled&quot;), ISPICKVAL({!$Record.Status__c}, &quot;Modified&quot;)))
  )
)</filterFormula>
        <object>Reservation__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
