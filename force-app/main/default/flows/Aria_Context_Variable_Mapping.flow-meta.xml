                <targetReference>Get_Messaging_End_User</targetReference>
            </connector>
            <label>Has End User ID</label>
        </rules>
    </decisions>
    <description>On MessagingSession create, resolves the authenticated EC user to a Contact and writes MessagingEndUser.ContactId. Path: MessagingEndUser.AuthenticatedEndUserId -&gt; User.ContactId -&gt; update MessagingEndUser.ContactId. Makes @MessagingEndUser.ContactId non-null for the Aria agent.</description>
    <label>Aria Context Variable Mapping</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Messaging_End_User</name>
        <label>Get Messaging End User</label>
        <locationX>176</locationX>
        <locationY>260</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_EndUser_Has_AuthUser</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Check_EndUser_Has_AuthUser</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.MessagingEndUserId</elementReference>
            </value>
        </filters>
        <object>MessagingEndUser</object>
        <outputAssignments>
