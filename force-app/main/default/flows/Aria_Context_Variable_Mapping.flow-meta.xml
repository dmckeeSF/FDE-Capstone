        </connector>
        <faultConnector>
            <targetReference>Check_Contact_Found</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EndUser_AuthUserId</elementReference>
            </value>
        </filters>
        <object>User</object>
        <outputAssignments>
