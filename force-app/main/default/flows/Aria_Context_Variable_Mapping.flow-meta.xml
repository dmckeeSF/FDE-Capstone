    <decisions>
        <name>Check_Contact_Found</name>
        <label>Contact Found?</label>
        <locationX>704</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Authenticated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Contact Not Found</defaultConnectorLabel>
        <rules>
            <name>Contact_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ContactRecord_Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_EndUserContactId</targetReference>
            </connector>
            <label>Contact Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_EndUser_Has_AuthUser</name>
        <label>Has AuthenticatedEndUserId?</label>
        <locationX>440</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Authenticated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Authenticated User</defaultConnectorLabel>
        <rules>
            <name>Has_Auth_User</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>EndUser_AuthUserId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_User_By_AuthId</targetReference>
            </connector>
            <label>Has Authenticated User</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_EndUser_Present</name>
        <label>MessagingEndUserId Present?</label>
        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Authenticated</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No End User</defaultConnectorLabel>
        <rules>
            <name>Has_EndUserId</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.MessagingEndUserId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Messaging_End_User</targetReference>
            </connector>
            <label>Has End User ID</label>
        </rules>
    </decisions>
    <description>Maps authenticated EC user identity to MessagingSession.EndUserContactId on session create. Resolves: MessagingEndUser.AuthenticatedEndUserId → User.ContactId → Contact. This populates @MessagingEndUser.ContactId for the Aria agent.</description>
    <label>Aria Context Variable Mapping</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contact_By_Auth_User</name>
        <label>Get Contact Fields</label>
        <locationX>704</locationX>
        <locationY>260</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Contact_Found</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Not_Authenticated</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EndUser_ContactId</elementReference>
            </value>
        </filters>
        <object>Contact</object>
        <outputAssignments>
            <assignToReference>ContactRecord_Id</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_Messaging_End_User</name>
        <label>Get Messaging End User</label>
        <locationX>176</locationX>
        <locationY>260</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_EndUser_Has_AuthUser</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Not_Authenticated</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.MessagingEndUserId</elementReference>
            </value>
        </filters>
        <object>MessagingEndUser</object>
        <outputAssignments>
            <assignToReference>EndUser_AuthUserId</assignToReference>
            <field>AuthenticatedEndUserId</field>
        </outputAssignments>
    </recordLookups>
    <recordLookups>
        <name>Get_User_By_AuthId</name>
        <label>Get User ContactId via AuthenticatedEndUserId</label>
        <locationX>440</locationX>
        <locationY>260</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contact_By_Auth_User</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Set_Not_Authenticated</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EndUser_AuthUserId</elementReference>
            </value>
        </filters>
        <object>User</object>
        <outputAssignments>
            <assignToReference>EndUser_ContactId</assignToReference>
            <field>ContactId</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
