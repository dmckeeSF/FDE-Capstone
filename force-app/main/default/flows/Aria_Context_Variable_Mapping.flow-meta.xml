        <locationX>176</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>No End User — end</defaultConnectorLabel>
        <rules>
            <name>Has_EndUserId</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.MessagingEndUserId</leftValueReference>
